{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "_comment.releases": "One package, at the root: every release is one version of everything, and every image is published at every tag (ADR-0005). A provider module is not a package of its own — a vendored tree beside it cannot be released against any other commit, so a version per provider could only name untested combinations. Adding a provider adds no key here.",
  "release-type": "go",
  "include-component-in-tag": false,
  "bootstrap-sha": "281e4e3ed2af1d6852651d69e1207a3073b478c2",
  "initial-version": "0.1.0",
  "changelog-type": "github",
  "pull-request-title-pattern": "release${scope}:${component} ${version}",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "package-name": "kcp-cluster-api"
    }
  },
