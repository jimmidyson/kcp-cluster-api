+# workloadsim fakes the workload cluster (an API server per Cluster, a Node per
+# Machine) so Machines reach Running. It lives in kcp-cluster-api as its own
+# module pinned to stock Cluster API, so `go install` reaches it directly.
+WORKLOADSIM_REF ?= main
+.PHONY: workloadsim
+workloadsim: ## Install the workloadsim binary into bin/ (WORKLOADSIM_REF selects the branch, tag or commit).
+	GOBIN=$(PWD)/bin GOFLAGS= go install github.com/jimmidyson/kcp-cluster-api/workloadsim/cmd/workloadsim@$(WORKLOADSIM_REF)
+
 .PHONY: test-sim
-test-sim: ntnx-sim ## Run the CAPX manager and CAPI core against ntnx-sim under envtest; no Nutanix hardware needed.
+test-sim: ntnx-sim workloadsim ## Run the CAPX manager and CAPI core against ntnx-sim and workloadsim under envtest; no Nutanix hardware needed.
 	go build -o bin/manager .
 	go build -o bin/capi-manager sigs.k8s.io/cluster-api
 	go build -o bin/simrun ./test/simulator/cmd/simrun
