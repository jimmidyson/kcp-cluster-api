// Dependency updates. Renovate replaces Dependabot here because Dependabot's
// Go updater follows go.work: an update at the root rewrote go.mod and go.sum
// in every vendored tree, whatever its exclude-paths said. Renovate updates
// the manifests it is pointed at and nothing else.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Titles are Conventional Commits and become the commit on main:
    // `build: ...` has no release effect (AGENTS.md, "PR title format").
    ":semanticCommitTypeAll(build)",
    ":semanticCommitScopeDisabled",
    "helpers:pinGitHubActionDigests",
  ],
  labels: ["dependencies"],

  // Only what this project owns and what an update can safely rewrite.
  // devbox.json, the Taskfile and everything else are bumped by hand; add a
  // manager here deliberately rather than by default.
  enabledManagers: ["gomod", "github-actions", "npm"],

  ignorePaths: [
    "**/node_modules/**",
    // The vendored upstream trees are upstream's dependency graphs and move
    // only by adopting a new upstream release. A bot edit to one is
    // unrecorded drift (ADR-0005).
    "third_party/forked/**",
    // Aligned with the CAPX tree it is built against; its dependencies move
    // when that tree's base moves. See providers/nutanix-infrastructure/DRIFT.md.
    "providers/nutanix-infrastructure/**",
    // Hugo modules. No Go package imports the Docsy theme, so `go mod tidy`
    // deletes the requirement instead of bumping it. Use `hugo mod get`.
    "docs/site/go.mod",
    // Generated by `hugo mod npm pack`.
    "docs/site/packages/**",
  ],

  // Let a release settle before proposing it. Security fixes are not delayed.
  minimumReleaseAge: "7 days",
  // Mondays, early (UTC).
  schedule: ["* 0-5 * * 1"],
  postUpdateOptions: ["gomodTidy"],

  // Pull requests for GitHub security advisories, raised at once whatever
  // the schedule says. Needs Dependabot *alerts* on in the repository
  // settings; Dependabot security *updates* should be off, or both bots open
  // a pull request for the same advisory.
  vulnerabilityAlerts: {
    labels: ["dependencies"],
  },

  packageRules: [
    // Go: every patch and minor update in one pull request; majors stay one
    // each. The families below override the group name, so order matters.
    {
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "go modules (minor and patch)",
    },
    // Families released together and only coherent at one version.
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["go.opentelemetry.io/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "opentelemetry",
    },
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/kcp-dev/**"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "kcp",
    },

    // Upgraded by hand, together: controller-runtime sets the Kubernetes
    // minor, and the rest must agree with what k8s.io expects. Patches still
    // flow through the group above.
    {
      matchManagers: ["gomod"],
      matchPackageNames: [
        "sigs.k8s.io/controller-runtime",
        "k8s.io/**",
        "github.com/prometheus/**",
        "go.etcd.io/**",
        "google.golang.org/grpc",
        "sigs.k8s.io/kind",
        // Shares k8s.io/kube-openapi with client-go.
        "sigs.k8s.io/kustomize/api",
      ],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    // Must match k8s.io exactly, so the CEL code behaves as k8s.io expects.
    {
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/google/cel-go"],
      enabled: false,
    },
    // Replaced in go.mod - by a vendored tree, or by a pinned fork - so the
    // version on the require line names nothing and must not be bumped.
    {
      matchManagers: ["gomod"],
      matchPackageNames: [
        "sigs.k8s.io/cluster-api",
        "sigs.k8s.io/cluster-api/**",
        "github.com/nutanix-cloud-native/cluster-api-provider-nutanix",
        "github.com/kcp-dev/multicluster-provider",
        "github.com/ifdotpy/multicluster-provider",
      ],
      enabled: false,
    },
    // The Go version comes from devbox and moves with it.
    {
      matchManagers: ["gomod"],
      matchDatasources: ["golang-version"],
      enabled: false,
    },

    // Build-time only: monthly, one pull request each.
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      schedule: ["* 0-5 1 * *"],
    },
    {
      matchManagers: ["npm"],
      groupName: "docs site npm",
      schedule: ["* 0-5 1 * *"],
    },
  ],
}
